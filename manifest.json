{
  "manifest_version": 3,
  "name": "MD Converter",
  "version": "1.1.0",
  "description": "Convert any page, PDF, screenshot, or file to Markdown using Gemini AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["sidebar/sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/sidebar.html",
        "sidebar/sidebar.js",
        "sidebar/sidebar.css",
        "utils/converter.js",
        "toast/toast.html",
        "toast/toast.js",
        "toast/toast.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
